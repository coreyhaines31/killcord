{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "make lint",
  "installCommand": "",
  "outputDirectory": "dist",
  "trailingSlash": true,
  "headers": [
    {
      "source": "/_a/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
